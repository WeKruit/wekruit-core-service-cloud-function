{
  "name": "wekruit-core-service-cloud-function",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "serve:web": "firebase emulators:start --only hosting",
    "serve:web:full": "npm run build && firebase emulators:start --only hosting,functions,firestore",
    "serve:staging": "npm run build && firebase emulators:start --project staging --only functions,firestore",
    "serve:production": "npm run build && firebase emulators:start --project production --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions,firestore",
    "deploy:web": "firebase deploy --only hosting",
    "deploy:web:staging": "firebase deploy --project staging --only hosting",
    "deploy:web:production": "firebase deploy --project production --only hosting",
    "deploy:staging": "firebase deploy --project staging --only functions,firestore",
    "deploy:production": "firebase deploy --project production --only functions,firestore",
    "logs": "firebase functions:log",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "googleapis": "^157.0.0",
    "luxon": "^3.7.2",
    "mailgun.js": "^12.1.0",
    "retell-sdk": "^5.9.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
