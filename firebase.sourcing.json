{
  "functions": {
    "source": "deploy/sourcing-functions",
    "codebase": "core-service",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "firebase.json",
      "*.log"
    ],
    "predeploy": [
      "npm run build:sourcing-bundle"
    ]
  },
  "hosting": {
    "site": "wekruit-sourcing",
    "public": "web",
    "ignore": [
      "firebase.json",
      "firebase.sourcing.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/sourcing/**",
        "function": {
          "functionId": "sourcing-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
